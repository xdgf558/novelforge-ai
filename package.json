{
  "name": "novelforge-ai",
  "version": "0.1.6",
  "description": "Local-first AI writing workbench for long-form serialized novels.",
  "author": "NovelForge AI",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:icon": "python3 scripts/generate-macos-icon.py",
    "desktop:pack:mac": "npm run desktop:icon && npm run build && SKIP_NOTARIZE=1 CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --publish never",
    "desktop:dist:mac": "npm run desktop:icon && npm run build && SKIP_NOTARIZE=1 CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "desktop:dist:mac:notarized": "npm run desktop:icon && npm run build && APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-simplecut-pro-notary} electron-builder --mac --publish never",
    "desktop:smoke": "node scripts/desktop-smoke.cjs",
    "test": "vitest run --exclude 'release/**'",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "mvp:acceptance": "node scripts/mvp-acceptance-smoke.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@electron/notarize": "^3.1.1",
    "autoprefixer": "^10.4.20",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.novelforge.ai",
    "productName": "NovelForge AI",
    "asar": true,
    "asarUnpack": [
      ".next/**/*",
      "app/**/*",
      "components/**/*",
      "lib/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/**/*",
      "prisma/schema.prisma",
      "prisma/migrations/**/*",
      "next.config.mjs",
      "package.json",
      "package-lock.json",
      "postcss.config.js",
      "tailwind.config.ts"
    ],
    "directories": {
      "output": "release/desktop"
    },
    "files": [
      ".next/**/*",
      "app/**/*",
      "components/**/*",
      "desktop/**/*",
      "lib/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/**/*",
      "prisma/schema.prisma",
      "prisma/migrations/**/*",
      "next.config.mjs",
      "package.json",
      "package-lock.json",
      "postcss.config.js",
      "tailwind.config.ts"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "timestamp": "http://timestamp.apple.com/ts01",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "HAO YE (Y35K7AQ974)",
      "signIgnore": [
        "\\.(?:png|jpe?g|gif|webp|svg|ico|icns|woff2?|ttf|otf|eot|map|pak|bin|dat)$"
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "NovelForge-AI-${version}-${os}-${arch}.${ext}"
    },
    "dmg": {
      "sign": true
    },
    "afterPack": "scripts/after-pack.cjs",
    "afterSign": "scripts/notarize.cjs"
  }
}
