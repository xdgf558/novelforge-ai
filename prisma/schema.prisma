generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                String   @id @default(cuid())
  title             String
  genre             String?
  targetAudience    String?
  platform          String?
  totalWordTarget   Int?
  chapterWordMin    Int?
  chapterWordMax    Int?
  updateFrequency   String?
  description       String?
  wechatPositioning String?
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  setting           ProjectSetting?
  settingVersions   SettingVersion[]
  characters        Character[]
  characterVersions CharacterVersion[]
  chapters          Chapter[]
  chapterVersions   ChapterVersion[]

  @@index([status])
  @@map("projects")
}

model ProjectSetting {
  id                    String   @id @default(cuid())
  projectId             String   @unique
  genre                 String?
  targetAudience        String?
  sellingPoint          String?
  mainConflict          String?
  worldviewRules        String?
  protagonistDesire     String?
  protagonistFlaw       String?
  villainLogic          String?
  supportingCharacters  String?
  factions              String?
  timeline              String?
  pleasureMechanism     String?
  forbiddenItems        String?
  styleSample           String?
  wechatPositioning     String?
  emotionalTone         String?
  readerExpectation     String?
  commercialHook        String?
  longTermForeshadowing String?
  endingDirection       String?
  sensitiveContentRules String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions SettingVersion[]

  @@map("project_settings")
}

model SettingVersion {
  id              String   @id @default(cuid())
  projectId       String
  settingId       String?
  versionNumber   Int
  snapshotJson    String
  changeReason    String?
  sourceType      String   @default("manual")
  sourceChapterId String?
  createdAt       DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  setting ProjectSetting? @relation(fields: [settingId], references: [id], onDelete: SetNull)

  @@index([projectId, versionNumber])
  @@index([settingId])
  @@map("setting_versions")
}

model Character {
  id                    String   @id @default(cuid())
  projectId             String
  name                  String
  roleInStory           String?
  identity              String?
  status                String   @default("active")
  speakingStyle         String?
  desire                String?
  fear                  String?
  secret                String?
  relationToProtagonist String?
  relationToAntagonist  String?
  knownInfo             String?
  hiddenInfo            String?
  abilityBoundary       String?
  behaviorRules         String?
  characterArc          String?
  firstAppearance       String?
  latestAppearance      String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions CharacterVersion[]

  @@index([projectId, status])
  @@index([projectId, name])
  @@map("characters")
}

model CharacterVersion {
  id              String   @id @default(cuid())
  projectId       String
  characterId     String
  versionNumber   Int
  snapshotJson    String
  changeReason    String?
  sourceType      String   @default("manual")
  sourceChapterId String?
  createdAt       DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([characterId, versionNumber])
  @@map("character_versions")
}

model Chapter {
  id            String   @id @default(cuid())
  projectId     String
  chapterNumber Int
  title         String
  status        String   @default("draft")
  goal          String?
  beats         String?
  draftText     String?
  finalText     String?
  notes         String?
  wordCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions ChapterVersion[]

  @@index([projectId, status])
  @@index([projectId, chapterNumber])
  @@map("chapters")
}

model ChapterVersion {
  id              String   @id @default(cuid())
  projectId       String
  chapterId       String
  versionNumber   Int
  snapshotJson    String
  changeReason    String?
  sourceType      String   @default("manual")
  sourceChapterId String?
  createdAt       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([chapterId, versionNumber])
  @@map("chapter_versions")
}
