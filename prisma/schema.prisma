generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                  String    @id @default(cuid())
  title               String
  genre               String?
  targetAudience      String?
  platform            String?
  totalWordTarget     Int?
  chapterWordMin      Int?
  chapterWordMax      Int?
  updateFrequency     String?
  description         String?
  wechatPositioning   String?
  coverImagePath      String?
  coverImageMimeType  String?
  coverImageFileName  String?
  coverImageSizeBytes Int?
  coverImageUpdatedAt DateTime?
  coverAltText        String?
  status              String    @default("active")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  setting           ProjectSetting?
  settingVersions   SettingVersion[]
  characters        Character[]
  characterVersions CharacterVersion[]
  chapters          Chapter[]
  chapterVersions   ChapterVersion[]
  outlines          Outline[]
  worldRules        WorldRule[]
  foreshadows       Foreshadow[]
  timelineEvents    TimelineEvent[]
  aiPromptTemplates AiPromptTemplate[]
  aiTasks           AiTask[]
  pendingUpdates    PendingUpdate[]
  continuityReports ContinuityReport[]
  publishPackages   PublishPackage[]
  publishTargets    PublishTarget[]
  publishRuns       PublishRun[]
  publishSyncStates PublishSyncState[]

  @@index([status])
  @@map("projects")
}

model ProjectSetting {
  id                    String   @id @default(cuid())
  projectId             String   @unique
  genre                 String?
  targetAudience        String?
  sellingPoint          String?
  mainConflict          String?
  worldviewRules        String?
  protagonistDesire     String?
  protagonistFlaw       String?
  villainLogic          String?
  supportingCharacters  String?
  factions              String?
  timeline              String?
  pleasureMechanism     String?
  forbiddenItems        String?
  styleSample           String?
  wechatPositioning     String?
  emotionalTone         String?
  readerExpectation     String?
  commercialHook        String?
  longTermForeshadowing String?
  endingDirection       String?
  sensitiveContentRules String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions SettingVersion[]

  @@map("project_settings")
}

model SettingVersion {
  id              String   @id @default(cuid())
  projectId       String
  settingId       String?
  versionNumber   Int
  snapshotJson    String
  changeReason    String?
  sourceType      String   @default("manual")
  sourceChapterId String?
  createdAt       DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  setting ProjectSetting? @relation(fields: [settingId], references: [id], onDelete: SetNull)

  @@index([projectId, versionNumber])
  @@index([settingId])
  @@map("setting_versions")
}

model Character {
  id                    String   @id @default(cuid())
  projectId             String
  name                  String
  roleInStory           String?
  identity              String?
  status                String   @default("active")
  speakingStyle         String?
  desire                String?
  fear                  String?
  secret                String?
  relationToProtagonist String?
  relationToAntagonist  String?
  knownInfo             String?
  hiddenInfo            String?
  abilityBoundary       String?
  behaviorRules         String?
  characterArc          String?
  firstAppearance       String?
  latestAppearance      String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions CharacterVersion[]

  @@index([projectId, status])
  @@index([projectId, name])
  @@map("characters")
}

model CharacterVersion {
  id              String   @id @default(cuid())
  projectId       String
  characterId     String
  versionNumber   Int
  snapshotJson    String
  changeReason    String?
  sourceType      String   @default("manual")
  sourceChapterId String?
  createdAt       DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([characterId, versionNumber])
  @@map("character_versions")
}

model Chapter {
  id            String   @id @default(cuid())
  projectId     String
  chapterNumber Int
  title         String
  status        String   @default("draft")
  goal          String?
  beats         String?
  draftText     String?
  polishedText  String?
  finalText     String?
  notes         String?
  wordCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions            ChapterVersion[]
  aiTasks             AiTask[]
  pendingUpdates      PendingUpdate[]
  plantedForeshadows  Foreshadow[]       @relation("PlantedChapter")
  resolvedForeshadows Foreshadow[]       @relation("ResolvedChapter")
  timelineEvents      TimelineEvent[]
  continuityReports   ContinuityReport[]
  publishPackages     PublishPackage[]

  @@index([projectId, status])
  @@index([projectId, chapterNumber])
  @@map("chapters")
}

model ChapterVersion {
  id              String   @id @default(cuid())
  projectId       String
  chapterId       String
  versionNumber   Int
  snapshotJson    String
  changeReason    String?
  sourceType      String   @default("manual")
  sourceChapterId String?
  createdAt       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([chapterId, versionNumber])
  @@map("chapter_versions")
}

model Outline {
  id                   String   @id @default(cuid())
  projectId            String
  level                String
  title                String
  status               String   @default("planned")
  sortOrder            Int      @default(0)
  content              String?
  volumeNumber         Int?
  unitNumber           Int?
  chapterNumber        Int?
  startChapter         Int?
  endChapter           Int?
  expectedChapters     Int?
  expectedWords        Int?
  goal                 String?
  mainlineProgression  String?
  mainConflict         String?
  mainAntagonist       String?
  keyTurns             String?
  climax               String?
  coreEvents           String?
  characterChanges     String?
  pleasureDesign       String?
  suspenseDesign       String?
  chapterConflict      String?
  chapterPleasurePoint String?
  foreshadow           String?
  resolvedForeshadow   String?
  characters           String?
  location             String?
  endingHook           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, level, sortOrder])
  @@index([projectId, level, volumeNumber])
  @@index([projectId, chapterNumber])
  @@map("outlines")
}

model AiPromptTemplate {
  id             String   @id @default(cuid())
  projectId      String
  key            String
  name           String
  taskType       String
  version        Int      @default(1)
  status         String   @default("active")
  outputFormat   String   @default("text")
  systemPrompt   String
  userPrompt     String
  contextNotes   String?
  responseSchema String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   AiTask[]

  @@unique([projectId, key, version])
  @@index([projectId, taskType])
  @@index([projectId, status])
  @@map("ai_prompt_templates")
}

model AiTask {
  id                  String    @id @default(cuid())
  projectId           String
  promptTemplateId    String?
  chapterId           String?
  taskType            String
  model               String
  status              String    @default("pending")
  adoptionState       String    @default("not_reviewed")
  inputContextSummary String
  inputJson           String?
  outputText          String?
  outputJson          String?
  errorMessage        String?
  tokenInput          Int?
  tokenOutput         Int?
  tokenTotal          Int?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  promptTemplate    AiPromptTemplate?  @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  chapter           Chapter?           @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  pendingUpdates    PendingUpdate[]
  continuityReports ContinuityReport[]
  publishPackages   PublishPackage[]

  @@index([projectId, taskType])
  @@index([projectId, status])
  @@index([promptTemplateId])
  @@index([chapterId])
  @@map("ai_tasks")
}

model WorldRule {
  id                   String   @id @default(cuid())
  projectId            String
  title                String
  content              String
  category             String?
  scope                String?
  relatedCharacters    String?
  relatedLocations     String?
  relatedOrganizations String?
  isCore               Boolean  @default(false)
  riskLevel            String   @default("medium")
  status               String   @default("active")
  sourceChapterId      String?
  pendingUpdateId      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pendingUpdate PendingUpdate? @relation(fields: [pendingUpdateId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([sourceChapterId])
  @@index([pendingUpdateId])
  @@map("world_rules")
}

model Foreshadow {
  id                     String   @id @default(cuid())
  projectId              String
  content                String
  status                 String   @default("planted")
  importance             String   @default("medium")
  expectedResolveChapter Int?
  relatedCharacters      String?
  relatedLocations       String?
  relatedFactions        String?
  plantedChapterId       String?
  resolvedChapterId      String?
  sourceChapterId        String?
  pendingUpdateId        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plantedChapter  Chapter?       @relation("PlantedChapter", fields: [plantedChapterId], references: [id], onDelete: SetNull)
  resolvedChapter Chapter?       @relation("ResolvedChapter", fields: [resolvedChapterId], references: [id], onDelete: SetNull)
  pendingUpdate   PendingUpdate? @relation(fields: [pendingUpdateId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([plantedChapterId])
  @@index([resolvedChapterId])
  @@index([pendingUpdateId])
  @@map("foreshadows")
}

model TimelineEvent {
  id                String   @id @default(cuid())
  projectId         String
  title             String
  description       String
  storyTime         String?
  relatedCharacters String?
  location          String?
  impact            String?
  status            String   @default("active")
  chapterId         String?
  sourceChapterId   String?
  pendingUpdateId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter       Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  pendingUpdate PendingUpdate? @relation(fields: [pendingUpdateId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([chapterId])
  @@index([pendingUpdateId])
  @@map("timeline_events")
}

model PendingUpdate {
  id              String    @id @default(cuid())
  projectId       String
  chapterId       String?
  aiTaskId        String?
  updateType      String
  targetType      String
  targetId        String?
  targetName      String?
  fieldName       String?
  title           String
  proposedContent String
  reason          String?
  riskLevel       String    @default("medium")
  evidence        String?
  payloadJson     String?
  status          String    @default("pending")
  resolutionNote  String?
  appliedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter        Chapter?        @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  aiTask         AiTask?         @relation(fields: [aiTaskId], references: [id], onDelete: SetNull)
  worldRules     WorldRule[]
  foreshadows    Foreshadow[]
  timelineEvents TimelineEvent[]

  @@index([projectId, status])
  @@index([projectId, targetType])
  @@index([chapterId])
  @@index([aiTaskId])
  @@map("pending_updates")
}

model ContinuityReport {
  id                String    @id @default(cuid())
  projectId         String
  chapterId         String?
  aiTaskId          String?
  severity          String    @default("medium")
  category          String    @default("general")
  title             String
  description       String
  evidence          String?
  conflictingMemory String?
  suggestedFix      String?
  status            String    @default("open")
  resolutionNote    String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  aiTask  AiTask?  @relation(fields: [aiTaskId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([chapterId])
  @@index([aiTaskId])
  @@map("continuity_reports")
}

model PublishPackage {
  id                  String   @id @default(cuid())
  projectId           String
  chapterId           String
  aiTaskId            String?
  titleCandidatesJson String?
  selectedTitle       String?
  openingGuide        String?
  chapterSummary      String?
  endingQuestion      String?
  nextChapterPreview  String?
  commentGuide        String?
  collectionTitle     String?
  coverPrompt         String?
  markdownBody        String?
  checklistJson       String?
  status              String   @default("draft")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  aiTask  AiTask? @relation(fields: [aiTaskId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([chapterId])
  @@index([aiTaskId])
  @@map("publish_packages")
}

model PublishTarget {
  id             String    @id @default(cuid())
  projectId      String
  name           String
  platformKey    String    @default("station_cat")
  apiBaseUrl     String?
  tokenSecret    String?
  tokenUpdatedAt DateTime?
  defaultMode    String    @default("draft")
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs       PublishRun[]
  syncStates PublishSyncState[]

  @@index([projectId, status])
  @@index([projectId, platformKey])
  @@map("publish_targets")
}

model PublishRun {
  id               String    @id @default(cuid())
  projectId        String
  targetId         String
  mode             String
  status           String    @default("completed")
  packageJson      String
  changedItemsJson String
  previewUrl       String?
  publishUrl       String?
  resultMessage    String?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target  PublishTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([targetId, createdAt])
  @@index([projectId, status])
  @@map("publish_runs")
}

model PublishSyncState {
  id           String    @id @default(cuid())
  projectId    String
  targetId     String
  localType    String
  localId      String
  remoteId     String?
  contentHash  String
  lastMode     String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target  PublishTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, localType, localId])
  @@index([projectId, localType])
  @@index([targetId, contentHash])
  @@map("publish_sync_states")
}
